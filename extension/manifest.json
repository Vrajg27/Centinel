{
  "manifest_version": 3,
  "name": "Centinel — Cybersecurity Assistant",
  "version": "1.0.0",
  "description": "Real-time phishing, malware and scam detection with AI-generated explanations. Syncs scan history with the Centinel Android app.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["*://localhost/*", "*://127.0.0.1/*"],
      "js": ["content/content-script.js"],
      "css": ["content/banner.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "webNavigation",
    "downloads",
    "notifications",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
